   "source": [
    "#Making a function that can be used for all planets\n",
    "\n",
    "def coverage(planet, sectors_data):\n",
    "    p = PLANETS[planet]                          \n",
    "    half = p[\"T14_h\"] / 24 / 2                   \n",
    "    expected = 2 * half * 720                    \n",
    "    rows = []\n",
    "    for d in sectors_data:                       \n",
    "        t = d[\"time\"]                            \n",
    "        n_lo = int(np.ceil((t.min() - half - p[\"T0\"]) / p[\"P\"]))    \n",
    "        n_hi = int(np.floor((t.max() + half - p[\"T0\"]) / p[\"P\"]))\n",
    "        n_in_sector = n_hi + 1 - n_lo\n",
    "        for n in range(n_lo, n_hi + 1):          \n",
    "            tc = p[\"T0\"] + n * p[\"P\"]            \n",
    "            inside = np.abs(t - tc) < half       \n",
    "            rows.append({\"planet\": planet, \"sector\": d[\"sector\"], \"epoch\": n,\n",
    "                         \"tc\": round(tc, 3), \"frac\": round(inside.sum() / expected, 2), \"n_in_sector\": n_in_sector})\n",
    "    return pd.DataFrame(rows)                    \n",
    "\n",
    "cov_b2 = coverage(\"b\", sectors_data)\n",
    "print(cov_b2.equals(cov_b))    #checking if the table is same as previous convergance table"
   ]
