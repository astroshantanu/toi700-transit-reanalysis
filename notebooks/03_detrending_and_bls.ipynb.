   "source": [
    "from wotan import flatten\n",
    "\n",
    "d = sectors_data[0]\n",
    "t = d[\"time\"]\n",
    "f = d[\"flux\"]\n",
    "\n",
    "print(\"median flux:\", np.median(f))   # should be close to 1 because we have normalized it\n",
    "\n",
    "# wotan is used to remove slow drifts due to various reasons like star moving, spacecraft pointing changing, etc\n",
    "# and keeps the fast drifts, which are the transits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "6a7cc489-b0ce-4c97-aec4-d8309a280b16",
   "metadata": {},
   "outputs": [],
   "source": [
