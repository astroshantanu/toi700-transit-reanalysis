    "#creating a mask function that works for all plaents\n",
    "\n",
    "def make_mask(t, margin=1.5):\n",
    "    mask = np.zeros(len(t), dtype=bool)\n",
    "    for name in [\"b\", \"c\", \"d\"]:\n",
    "        p = PLANETS[name]\n",
    "        half = p[\"T14_h\"] / 24 / 2\n",
    "        n_lo = int(np.ceil((t.min() - half - p[\"T0\"]) / p[\"P\"]))\n",
    "        n_hi = int(np.floor((t.max() + half - p[\"T0\"]) / p[\"P\"]))\n",
    "        for n in range(n_lo, n_hi + 1):\n",
    "            tc = p[\"T0\"] + n * p[\"P\"]\n",
    "            pad = np.hypot(max(p[\"T0_err\"]), abs(n) * max(p[\"P_err\"]))   # hypot is √(a² + b²) for errors in T0 and P\n",
    "            mask |= np.abs(t - tc) < half * margin + pad                 # it is added here as the n grows for later transits\n",
    "    return mask                                                          # the predicted place of transit from actual transit \n",
    "                                                                         # will shift significantly\n",
    "t = sectors_data[0][\"time\"]\n",
