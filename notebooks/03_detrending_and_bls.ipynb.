   "source": [
    "# BUILDING A MASK\n",
    "# which is basically telling wotan which points exist near the transit, \n",
    "# so as not to leave them out while estimating the trend\n",
    "\n",
    "p = PLANETS[\"b\"]\n",
    "half = p[\"T14_h\"] / 24 / 2\n",
    "margin = 1.5                      # mask 1.5x wider than the transit\n",
    "\n",
    "n_lo = int(np.ceil((t.min() - half - p[\"T0\"]) / p[\"P\"]))\n",
    "n_hi = int(np.floor((t.max() + half - p[\"T0\"]) / p[\"P\"]))\n",
    "\n",
    "mask = np.zeros(len(t), dtype=bool)     # start: nothing masked\n",
